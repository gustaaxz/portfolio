---
---

<aside class="journey-rail" aria-hidden="true">
	<div class="rail-track">
		<div class="rail-fill"></div>
		<div class="journey-token">
			<svg viewBox="0 0 40 40">
				<path d="M30.5 6.5C19 6 9 12.5 9 22.5c0 6.5 4.5 10.5 10 10.5 10 0 16-12.5 11.5-26.5Z" fill="currentColor"></path>
				<path d="M9.5 33c4.5-7.5 10-13 20-19" fill="none" stroke="#c7795b" stroke-width="1.6" stroke-linecap="round"></path>
				<path d="M15.5 26c0-3-1.8-5.2-4.4-6.5M21 22c3.1-.2 5.3 1 7.1 3.8" fill="none" stroke="#c7795b" stroke-width="1.2" stroke-linecap="round"></path>
			</svg>
		</div>
	</div>
</aside>

<style>
	.journey-rail {
		position: fixed;
		top: 50%;
		right: 36px;
		z-index: 20;
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.rail-track {
		position: relative;
		width: 1px;
		height: 36vh;
		min-height: 200px;
		background: var(--line);
	}

	.rail-fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 1px;
		height: 100%;
		background: var(--sage);
		transform: scaleY(0);
		transform-origin: top;
	}

	.journey-token {
		position: absolute;
		top: 0;
		left: 50%;
		width: 46px;
		height: 46px;
		margin-left: -23px;
		color: var(--sage);
		will-change: transform;
	}

	.journey-token svg {
		width: 100%;
		height: 100%;
	}

	.journey-token::before {
		content: '';
		position: absolute;
		inset: -12px;
		border-radius: 50%;
		border: 1px solid rgba(184, 196, 164, 0.3);
	}

	@media (max-width: 760px) {
		.journey-rail {
			right: 14px;
		}

		.rail-track {
			height: 28vh;
		}

		.journey-token {
			width: 36px;
			height: 36px;
			margin-left: -18px;
		}
	}
</style>

<script>
	const track = document.querySelector('.rail-track') as HTMLElement;
	const token = document.querySelector('.journey-token') as HTMLElement;
	const fill = document.querySelector('.rail-fill') as HTMLElement;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	let target = 0;
	let current = 0;
	let running = false;

	const readProgress = () => {
		const max = document.documentElement.scrollHeight - window.innerHeight;
		return max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
	};

	const paint = () => {
		const travel = Math.max(0, track.offsetHeight - token.offsetHeight);
		token.style.transform = `translate3d(0, ${current * travel}px, 0) rotate(${current * 360}deg)`;
		fill.style.transform = `scaleY(${current})`;
	};

	const loop = () => {
		current = reduceMotion.matches ? target : current + (target - current) * 0.12;
		paint();
		if (Math.abs(target - current) > 0.0005) {
			requestAnimationFrame(loop);
		} else {
			current = target;
			paint();
			running = false;
		}
	};

	const onScroll = () => {
		target = readProgress();
		if (!running) {
			running = true;
			requestAnimationFrame(loop);
		}
	};

	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', onScroll);
	onScroll();
</script>
